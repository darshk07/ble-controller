{
  "name": "ble-controller",
  "version": "0.1.0",
  "description": "Desktop controller for Magic Lantern BLE LED strips",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win portable",
    "start": "electron-vite preview",
    "probe": "tsx scripts/probe.ts",
    "test": "node --experimental-test-module-mocks --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/mac-dev-permissions.mjs"
  },
  "build": {
    "appId": "com.darshk07.lantern",
    "productName": "Lantern",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darshk07/ble-controller.git"
  },
  "bugs": {
    "url": "https://github.com/darshk07/ble-controller/issues"
  },
  "homepage": "https://github.com/darshk07/ble-controller#readme",
  "dependencies": {
    "@stoprocent/noble": "^2.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js"
}
